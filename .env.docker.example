# ==============================================================================
# TAPSTAR - DOCKER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public URL where the website is accessed by users and scanned by NFC/QR
# Contoh lokal: http://localhost (atau http://IP_SERVER)
# Contoh domain: https://review.namabisnis.com
PUBLIC_BASE_URL=http://localhost

# Port exposed di server host (Default: 80 untuk HTTP biasa)
PORT=80

# Database Configuration (PostgreSQL Container)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tapstar_db

# Google Places API Key (Opsional; kosongkan jika ingin mode live tanpa API key)
GOOGLE_PLACES_API_KEY=

# Security & JWT Token
SECRET_KEY=tapstar-super-secret-jwt-key-production-ready-2026

# Akun Bawaan Super Admin (Dibuat otomatis pada database seed pertama kali)
DEFAULT_SUPERADMIN_USERNAME=superadmin
DEFAULT_SUPERADMIN_PASSWORD=Password123!
