# ==========================================
# RateGrabber Docker Environment Configuration
# ==========================================

# Public URL where the website is accessed by users and scanned by NFC/QR
# Example for local: http://localhost
# Example for domain: https://review.namatoko.com
PUBLIC_BASE_URL=http://localhost

# Port exposed on the host machine (Default: 80)
PORT=80

# Google Places API Key (Add your Google Cloud key for live search)
GOOGLE_PLACES_API_KEY=

# Admin Master PIN
ADMIN_PIN=123456

# Application Secret Key
SECRET_KEY=rate-grabber-change-this-secret-in-production
